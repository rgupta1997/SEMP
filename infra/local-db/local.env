# Overrides for running the API against the local docker database.
# Loaded BEFORE apps/api/.env (dotenv never overrides what is already set), so
# these win without touching that file. Throwaway values - local only.
NODE_ENV=development
DATABASE_URL=postgresql://semp:semp@127.0.0.1:5433/semp
DIRECT_URL=postgresql://semp:semp@127.0.0.1:5433/semp
JWT_SECRET=local-dev-secret-not-for-anything-real
WEB_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173
# No AWS / mail account needed locally.
REALTIME_TRANSPORT=off
MAIL_TRANSPORT=console
AUTH_EMAIL_BYPASS=true
OTP_SMS_BYPASS=true
AISENSY_API_KEY=
SEED_ADMIN_EMAIL=admin@semp.local
SEED_ADMIN_PASSWORD=admin123
PORT=4000
