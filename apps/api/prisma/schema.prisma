/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tournament_disciplines {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournament_sport_id String              @db.Uuid
  discipline_id       String?             @db.Uuid
  format_id           String?             @db.Uuid
  format_config       Json                @default("{}")
  venue_id            String?             @db.Uuid
  rulebook_url        String?
  entry_type          String?             @db.VarChar
  squad_min           Int?                @db.SmallInt
  squad_max           Int?                @db.SmallInt
  status              String              @default("upcoming") @db.VarChar
  display_order       Int                 @default(0)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  fixtures            fixtures[]
  teams               teams[]
  disciplines         disciplines?        @relation(fields: [discipline_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tournament_formats  tournament_formats? @relation(fields: [format_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tournament_sports   tournament_sports   @relation(fields: [tournament_sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venues              venues?             @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tournament_sport_id, discipline_id])
  @@index([discipline_id], map: "idx_tournament_disciplines_discipline_id")
  @@index([format_id], map: "idx_tournament_disciplines_format_id")
  @@index([tournament_sport_id], map: "idx_tournament_disciplines_tournament_sport_id")
  @@index([venue_id], map: "idx_tournament_disciplines_venue_id")
}

model tournament_formats {
