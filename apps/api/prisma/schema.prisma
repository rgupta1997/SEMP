  users_user_championship_roles_assigned_byTousers users?        @relation("user_championship_roles_assigned_byTousers", fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_event_roles_assigned_by_fkey")
  championships                                    championships @relation(fields: [championship_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_event_roles_event_id_fkey")
  roles                                            roles         @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_event_roles_role_id_fkey")
  users_user_championship_roles_user_idTousers     users         @relation("user_championship_roles_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_event_roles_user_id_fkey")

  @@unique([user_id, championship_id, role_id], map: "user_event_roles_user_id_event_id_role_id_key")
  @@index([assigned_by], map: "idx_user_event_roles_assigned_by")
  @@index([championship_id], map: "idx_user_event_roles_event_id")
