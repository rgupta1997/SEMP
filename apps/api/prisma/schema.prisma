generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model disciplines {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sport_id               String                   @db.Uuid
  name                   String                   @db.VarChar
  description            String?                  @db.VarChar
  entry_type             String                   @default("team") @db.VarChar
  squad_min              Int                      @default(1) @db.SmallInt
  squad_max              Int                      @default(15) @db.SmallInt
  display_order          Int                      @default(0)
  sports                 sports                   @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tournament_disciplines tournament_disciplines[]

  @@index([sport_id], map: "idx_disciplines_sport_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model championship_organizations {
  id                                                  String         @id(map: "event_institutions_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  championship_id                                     String         @db.Uuid
  organization_id                                     String         @db.Uuid
  status                                              String         @default("pending") @db.VarChar
  applied_by                                          String         @db.Uuid
  reviewed_by                                         String?        @db.Uuid
  rejection_note                                      String?
  applied_at                                          DateTime       @default(now()) @db.Timestamptz(6)
  reviewed_at                                         DateTime?      @db.Timestamptz(6)
  users_championship_organizations_applied_byTousers  users          @relation("championship_organizations_applied_byTousers", fields: [applied_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_institutions_applied_by_fkey")
  championships                                       championships  @relation(fields: [championship_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_institutions_event_id_fkey")
  organizations                                       organizations  @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_institutions_institution_id_fkey")
  users_championship_organizations_reviewed_byTousers users?         @relation("championship_organizations_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_institutions_reviewed_by_fkey")
  team_entries                                        team_entries[]

  @@unique([championship_id, organization_id], map: "event_institutions_event_id_institution_id_key")
  @@index([applied_by], map: "idx_event_institutions_applied_by")
  @@index([championship_id], map: "idx_event_institutions_event_id")
  @@index([organization_id], map: "idx_event_institutions_institution_id")
  @@index([reviewed_by], map: "idx_event_institutions_reviewed_by")
  @@index([championship_id, status], map: "idx_event_institutions_event_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model championships {
  id                         String                       @id(map: "events_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                       @db.VarChar
  slug                       String                       @unique(map: "events_slug_key") @db.VarChar
  description                String?
  venue                      String?                      @db.VarChar
  start_date                 DateTime                     @db.Date
  end_date                   DateTime                     @db.Date
  status                     String                       @default("draft") @db.VarChar
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  visibility                 String                       @default("public") @db.VarChar
  championship_invitations   championship_invitations[]
  championship_officials     championship_officials[]
  championship_organizations championship_organizations[]
  feedback                   feedback[]
  notifications              notifications[]
  sponsors                   sponsors[]
  standings                  standings[]
  standings_rules            standings_rules[]
  team_entries               team_entries[]
  tournaments                tournaments[]
  user_championship_roles    user_championship_roles[]
  venues                     venues[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fixtures {
  id                                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournament_discipline_id             String                 @db.Uuid
  home_team_id                         String?                @db.Uuid
  away_team_id                         String?                @db.Uuid
  venue_ground_id                      String?                @db.Uuid
  round                                String?                @db.VarChar
  pool_number                          Int?                   @db.SmallInt
  bracket_position                     Int?
  scheduled_at                         DateTime?              @db.Timestamptz(6)
  duration_minutes                     Int?
  status                               String                 @default("scheduled") @db.VarChar
  official_id                          String?                @db.Uuid
  notes                                String?
  created_at                           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime               @default(now()) @db.Timestamptz(6)
  home_score                           Int?
  away_score                           Int?
  winner_team_id                       String?                @db.Uuid
  live_state                           Json                   @default("{}")
  live_log                             Json                   @default("[]")
  fixture_awards                       fixture_awards[]
  fixture_events                       fixture_events[]
  teams_fixtures_away_team_idToteams   teams?                 @relation("fixtures_away_team_idToteams", fields: [away_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teams_fixtures_home_team_idToteams   teams?                 @relation("fixtures_home_team_idToteams", fields: [home_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                users?                 @relation(fields: [official_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tournament_disciplines               tournament_disciplines @relation(fields: [tournament_discipline_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venue_grounds                        venue_grounds?         @relation(fields: [venue_ground_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teams_fixtures_winner_team_idToteams teams?                 @relation("fixtures_winner_team_idToteams", fields: [winner_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([away_team_id], map: "idx_fixtures_away_team_id")
  @@index([home_team_id], map: "idx_fixtures_home_team_id")
  @@index([official_id], map: "idx_fixtures_official_id")
  @@index([tournament_discipline_id], map: "idx_fixtures_tournament_discipline_id")
  @@index([venue_ground_id], map: "idx_fixtures_venue_ground_id")
  @@index([winner_team_id], map: "idx_fixtures_winner_team_id")
  @@index([tournament_discipline_id, pool_number, bracket_position, created_at], map: "idx_fixtures_draw_ordering")
  @@index([official_id, scheduled_at], map: "idx_fixtures_official_scheduled")
}

model organizations {
  id                         String                       @id(map: "institutions_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                       @db.VarChar
  short_name                 String?                      @db.VarChar
  code                       String?                      @unique(map: "institutions_code_key") @db.VarChar
  logo_url                   String?
  city                       String?                      @db.VarChar
  status                     Boolean?
  country                    String                       @default("India") @db.VarChar
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  championship_invitations   championship_invitations[]
  championship_organizations championship_organizations[]
  organization_members       organization_members[]
  standings                  standings[]
  team_entries               team_entries[]
  teams                      teams[]
  users                      users[]
}

model organization_members {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String        @db.Uuid
  organization_id String        @db.Uuid
  role            String        @default("member") @db.VarChar
  status          String        @default("active") @db.VarChar
  joined_at       DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, organization_id])
  @@index([organization_id], map: "idx_organization_members_organization_id")
  @@index([user_id], map: "idx_organization_members_user_id")
  @@index([organization_id, status], map: "idx_organization_members_org_status")
}

model permissions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique @db.VarChar
  label      String   @db.VarChar
  rules      Json[]   @default([])
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model roles {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                    @unique @db.VarChar
  description             String?                   @db.VarChar
  permission_ids          String[]                  @default([]) @db.Uuid
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
