model users {
  id                                                                       String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                                     String                       @db.VarChar
  email                                                                    String                       @unique @db.VarChar
  phone                                                                    String?                      @db.VarChar
  avatar_url                                                               String?
  is_active                                                                Boolean                      @default(true)
  created_at                                                               DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                                                               DateTime                     @default(now()) @db.Timestamptz(6)
  password_hash                                                            String?
  is_super_admin                                                           Boolean                      @default(false)
  organization_id                                                          String?                      @db.Uuid
  account_type                                                             String?                      @default("participant") @db.VarChar
  must_change_password                                                     Boolean                      @default(false)
  /// Person-level facts (J1-E5). Identical in every institution, so they live
  /// here rather than on the membership. `gender` carries 'prefer_not_to_say'
  /// as a real value, never a null.
  date_of_birth                                                            DateTime?                    @db.Date
  gender                                                                   String?
