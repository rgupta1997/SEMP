# ---- API ----
# REQUIRED, and deliberately without a default. Every production guard in
# apps/api/src/config/env.schema.ts keys off this value, so a deploy target that
# forgets it used to boot with the OTP bypasses ON and every guard inert - which
# is exactly what the Lambda deploy path did. Unset or misspelled is now a boot
# crash. One of: development | test | production.
NODE_ENV=development

# Supabase Postgres direct connection (port 5432) used by Prisma at runtime & for introspection.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
JWT_SECRET="change-me-in-production"
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL="admin@semp.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Platform Admin"

# ---- Web ----
#
# Read by apps/web (Vite loads apps/web/.env, NOT this file - this is the API's).
# All of them are inlined at BUILD time, so changing one needs a rebuild rather than
# a restart. On Netlify they live in Site settings -> Environment.

# The API origin: no trailing slash, no /api - the client appends /api itself.
# Local:      http://localhost:4000
# UAT:        https://o30gqya1sg.execute-api.ap-south-1.amazonaws.com
# Production: https://www.events-api.sportagon.in
VITE_API_URL="http://localhost:4000"

# Marketing site origin, read at AuthPage.tsx. Falls back to '/'.
VITE_LANDING_URL=

# landing-page-v2 is a SEPARATE build with its own npm install, outside the npm
# workspaces. It reads VITE_API_URL too (the "Book a demo" form) plus:
#   VITE_APP_URL   where the product lives; falls back to '/app'

# ---------------------------------------------------------------------------
# Live notifications (AppSync Events) need NO frontend variable at all.
# ---------------------------------------------------------------------------
# The endpoint, the region and the channel path all arrive at runtime in the response
# to POST /notifications/realtime-token. There is no VITE_APPSYNC_* on purpose: Vite
# inlines its variables at build time, so a baked-in endpoint would keep pointing at a
# replaced stack until somebody remembered to rebuild - which is exactly the failure
# mode VITE_API_URL above still has, and which infra/README.md documents as a gotcha.
# Asking the API instead removes the class of problem.
#
# The server side of this lives in the API section above: REALTIME_TRANSPORT and its
# APPSYNC_* companions.

# ---- Mail ----
# Delivery goes through the Sportagon Mail Service (docs/integration-guide.md).
# "console" logs each message instead of sending it, so the sign-in flow runs with no
# mail account. Production must be "http" - env.ts refuses to boot otherwise.
MAIL_TRANSPORT="console"

# The BASE ORIGIN of the mail service - no path. The client appends /mail, /templates.
MAIL_API_URL="http://localhost:3000"

# The SECRET ONLY. Keys are issued as `callerName:secret`; sending the pair is a 401.
MAIL_API_KEY=""

# The OTP send is inline on sign-in and the service cold-starts, so this bounds how
# long a sign-in can wait on it. Node's fetch has no default timeout.
MAIL_TIMEOUT_MS=5000

# ---- Realtime notifications (AppSync Events) ----
# "off" makes every notification a feed-only write, so a fresh clone runs with no AWS
# account and the bell falls back to its 2-minute poll. Production must be "appsync" -
# env.schema.ts refuses to boot otherwise, because a silently-degraded bell is a
# perfectly usable product and therefore something nobody reports.
REALTIME_TRANSPORT="off"

# Both are semp-api stack outputs, and both are REQUIRED once the transport is on.
# The web app does NOT get the endpoint as a VITE_ var - it is handed to the browser
# by POST /notifications/realtime-token, so redeploying the stack never needs a
# frontend rebuild.
APPSYNC_NOTIFICATIONS_QUEUE_URL=
# The Dns.Http stack output HOSTNAME (no scheme, no path). Yes, the HTTP one -
# the browser connects over WebSockets but Amplify derives that URL from this.
APPSYNC_EVENTS_HTTP_ENDPOINT=
APPSYNC_EVENTS_REGION="ap-south-1"

# Where the web app lives, as ONE origin - every link in an email is built from this.
# WEB_ORIGIN cannot be reused: it is a comma-separated CORS allow-list in production.
WEB_APP_URL="http://localhost:5173"
