# ---- API ----
# REQUIRED, and deliberately without a default. Every production guard in
# apps/api/src/config/env.schema.ts keys off this value, so a deploy target that
# forgets it used to boot with the OTP bypasses ON and every guard inert - which
# is exactly what the Lambda deploy path did. Unset or misspelled is now a boot
# crash. One of: development | test | production.
NODE_ENV=development

# Supabase Postgres direct connection (port 5432) used by Prisma at runtime & for introspection.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
JWT_SECRET="change-me-in-production"
SUPABASE_JWT_SECRET="Use it from your supabase project"
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL="admin@semp.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Platform Admin"

# ---- Web ----
VITE_API_URL="http://localhost:4000"
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Mail ----
# Delivery goes through the Sportagon Mail Service (docs/integration-guide.md).
# "console" logs each message instead of sending it, so the sign-in flow runs with no
# mail account. Production must be "http" - env.ts refuses to boot otherwise.
MAIL_TRANSPORT="console"

# The BASE ORIGIN of the mail service - no path. The client appends /mail, /templates.
MAIL_API_URL="http://localhost:3000"

# The SECRET ONLY. Keys are issued as `callerName:secret`; sending the pair is a 401.
MAIL_API_KEY=""

# The OTP send is inline on sign-in and the service cold-starts, so this bounds how
# long a sign-in can wait on it. Node's fetch has no default timeout.
MAIL_TIMEOUT_MS=5000

# Where the web app lives, as ONE origin - every link in an email is built from this.
# WEB_ORIGIN cannot be reused: it is a comma-separated CORS allow-list in production.
WEB_APP_URL="http://localhost:5173"
