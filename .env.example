# ---- API ----
# Supabase Postgres direct connection (port 5432) used by Prisma at runtime & for introspection.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
JWT_SECRET="change-me-in-production"
SUPABASE_JWT_SECRET="Use it from your supabase project"
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL="admin@semp.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Platform Admin"

# ---- Web ----
VITE_API_URL="http://localhost:4000"
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- WhatsApp OTP (AiSensy) ----
# Phone sign-in codes are delivered over WhatsApp. Leave AISENSY_API_KEY empty in
# development and the API falls back to the SMS stub, which logs the code and
# returns it in the /auth/otp/send response (OTP_SMS_BYPASS). Both are refused in
# production. A key that its AiSensy account has not enabled for the Campaign API
# answers ERR401 "Unauthorized" to every call, whatever the payload.
AISENSY_API_KEY=
# The campaign bound to the approved WhatsApp authentication template.
AISENSY_OTP_CAMPAIGN="otp"
AISENSY_API_URL="https://backend.aisensy.com/campaign/t1/api/v2"
# Dialling code added to the bare 10-digit numbers we store.
OTP_PHONE_COUNTRY_CODE="91"
